{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tk-light screen sender",
  "version": "../package.json",
  "identifier": "dev.kempf.tklightsender",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1423",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Screen sender",
        "width": 460,
        "height": 460,
        "resizable": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
