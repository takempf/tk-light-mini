{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tk-light-mini",
  "version": "../package.json",
  "identifier": "dev.kempf.tklightmini",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "tk-light-mini",
        "width": 1040,
        "height": 760,
        "minWidth": 420,
        "minHeight": 480,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "kempf",
    "license": "MIT",
    "category": "Utility",
    "shortDescription": "Screen-reactive ambient lighting for Govee and iCUE lights",
    "homepage": "https://github.com/takempf/tk-light-mini",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlGREE0NUNGNjY3N0QwNzgKUldSNDBIZG16MFhhbnltNXJvdXUwQ3hPU0hINFJ1RHJwWHRrWm13UWtzWkRIQmRGbjl3RHZxc3kK",
      "endpoints": [
        "https://github.com/takempf/tk-light-mini/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
